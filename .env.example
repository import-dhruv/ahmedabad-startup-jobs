# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ahmedabad_jobs
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ahmedabad_jobs
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/ahmedabad_jobs
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Security (generate with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth — leave empty to disable Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
USER_AGENT=Mozilla/5.0 (compatible; AhmedabadStartupJobsBot/1.0; +https://ahmedabadstartupjobs.com/bot)
HTTP_TIMEOUT=25
HTTP_MAX_CONCURRENCY=8
RESPECT_ROBOTS_TXT=true
MAX_JOBS_PER_SOURCE_RUN=500
JOB_STALE_AFTER_DAYS=14
JOB_EXPIRE_AFTER_DAYS=45

# ---------------------------------------------------------------------------
# AI (optional — the platform works fully without it)
# ---------------------------------------------------------------------------
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Email notifications (optional)
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@ahmedabadstartupjobs.com

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
